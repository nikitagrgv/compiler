fn main(): i32
{
    // some comment
    let x: i32 = -1 - (-2 + 3) * -4 * 5 - 6 * -(-7);
    {
        let xxx: i32 = -5;
        x = xxx + 1;
    }
    let y = spam(0xabc * x, x);
    x = spam(5 + 1 * spam(-2 + 3) * -4, -4 + y);
    noop();
    noop() = noop();
    let z: i32 = 0b111110101 / 2;
    return x + y * z;
}

fn noop()
{
    return;
}

fn spam(a: i32, b: i32): i32
{
    return a + b + 1;
}
